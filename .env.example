APP_NAME=Portal
APP_URL=https://kr-flow.ru
APP_ENV=production
JWT_SECRET=change-me-to-64-random-chars-minimum-please-do-not-use-this
JWT_TTL_HOURS=12

BOOTSTRAP_ADMIN_EMAIL=admin@forgecrm.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_change_me
POSTGRES_DB=forgecrm
DATABASE_URL=postgres://forge:forge_change_me@127.0.0.1:5432/forgecrm?sslmode=disable

REDIS_URL=redis://127.0.0.1:6379/0
SEARCH_ENGINE=postgres
SKIP_AMI=1

RABBITMQ_USER=forge
RABBITMQ_PASSWORD=forge_rmq_change_me

MINIO_ROOT_USER=forge_minio
MINIO_ROOT_PASSWORD=forge_minio_change_me
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=forgecrm
S3_ACCESS_KEY=forge_minio
S3_SECRET_KEY=forge_minio_change_me

AMI_HOST=host.docker.internal
AMI_PORT=5038
AMI_USER=forgecrm
AMI_SECRET=ami_change_me_now

VK_ADS_TOKEN=
VK_ADS_ACCOUNT_ID=
VK_ADS_WEBHOOK_SECRET=vk_webhook_secret_change_me

# Входящий вебхук Bitrix24 (не пароль админа). Можно не писать сюда и вставить в UI.
BITRIX_WEBHOOK_URL=

# Телефония. Ключи только в env, не в git и не в чат.
# CALL_PROVIDER=auto
# TELFIN_APP_ID=
# TELFIN_APP_SECRET=
# UIS_ACCESS_TOKEN=
# UIS_VIRTUAL_PHONE=
# CALL_WEBHOOK_SECRET=
# Журнал звонков: POST /webhooks/telephony/voximplant/{секрет}
# Сценарий Voximplant шлёт JSON сюда. Bitrix не используем.
# Запись разговора (прослушивание в карточке):
#   в manage.voximplant.com → Application → Config:
#     crm_call_webhook_secret = тот же CALL_WEBHOOK_SECRET
#   сценарий telephony/scenarios/main.js шлёт {event:recording, recording_url}
#   CRM кладёт recording_key и отдаёт аудио на GET /telephony/calls/{id}/recording

# Входящие линии. Ключи только в env, не в git и не в чат.
# MAX Bot API (нативный): MAX_BOT_TOKEN → platform-api2.max.ru
#   локально: long poll (MAX_BOT_POLL=1, по умолчанию)
#   prod HTTPS: POST /subscriptions на /webhooks/inbox/max/{INBOX_WEBHOOK_SECRET}, тогда MAX_BOT_POLL=0
# Wappi MAX: токен + profile_id из https://wappi.pro
#   при старте API регистрирует webhook:
#   {PUBLIC_BASE_URL}/webhooks/inbox/wappi/{INBOX_WEBHOOK_SECRET}
#   на линии — profile_id (или WAPPI_PROFILE_ID в .env)
# PUBLIC_BASE_URL=https://kr-flow.ru
# INBOX_WEBHOOK_SECRET=
# MAX_BOT_TOKEN=
# MAX_BOT_POLL=1
# WAPPI_TOKEN=
# WAPPI_PROFILE_ID=
# Заявки с форм: POST /webhooks/leads/{секрет} или /webhooks/leads/google/{секрет}
# Тот же INBOX_WEBHOOK_SECRET. Историю не качаем.

# Яндекс Почта (IMAP) — письма VK Ads (ads.notifications@vk.company) → лиды
# В почте: Настройки → Почтовые программы → разрешить IMAP + пароль приложения
# YANDEX_IMAP_USER=you@yandex.ru
# YANDEX_IMAP_PASSWORD=
# YANDEX_IMAP_FOLDER=INBOX
# YANDEX_IMAP_POLL=30

# Avito Работа — только новые отклики, историю не качаем. Ключи не в git и не в чат.
# Вебхук: POST/GET /webhooks/avito/{секрет}  (тот же INBOX_WEBHOOK_SECRET)
# Без ключей лид создаётся по id отклика. С ключами подтягиваем ФИО и телефон.
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=

# Telegram-бот для логистов: уведомление, когда сделка ушла в «Билет».
# 1) @BotFather → создать бота → TELEGRAM_BOT_TOKEN
# 2) Логист пишет боту /start (chat_id сохранится) ИЛИ задайте TELEGRAM_LOGIST_CHAT_IDS=123,-456
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LOGIST_CHAT_IDS=

# Отдельный бот заявок только для МСК Башня. Токен НЕ тот же, что TELEGRAM_BOT_TOKEN.
# Оператор присылает номер, имя, возраст, город и доп. информацию.
# Карточка садится на РОПа этого отдела, в общий банк не попадает.
# TELEGRAM_MSK_TOWER_BOT_TOKEN=
# TELEGRAM_MSK_TOWER_OPERATOR_IDS=123456,789012

# --- Softphone (браузер): Voximplant / МТС Exolve ---
# Master switch in code: src/telephony/config.ts → TELEPHONY_ENABLED
# Значения только в локальном .env, не в git и не в чат.
VITE_TELEPHONY_PROVIDER=vox
VITE_VOX_NODE=NODE_3
VITE_VOX_USERNAME=
VITE_VOX_PASSWORD=
VITE_VOX_DEFAULT_DEST=
# Secure-записи Vox: service account JSON (не в git). По умолчанию ищет voximplant-service-account.json
# VOX_SERVICE_ACCOUNT_JSON=voximplant-service-account.json

VITE_EXOLVE_SIP_LOGIN=
VITE_EXOLVE_SIP_PASSWORD=
VITE_EXOLVE_DEFAULT_DEST=

# Exolve Management API (сервер) — карусель CLI, входящие, import пула.
# API-ключ: ЛК Exolve → приложение → API-ключ. Не в VITE_* и не в git.
# EXOLVE_API_KEY=
# EXOLVE_SIP_LOGIN=          # fallback SIP login (иначе VITE_EXOLVE_SIP_LOGIN)
# EXOLVE_SIP_PASSWORD=       # fallback SIP password (иначе VITE_EXOLVE_SIP_PASSWORD)
# EXOLVE_INBOUND_NUMBERS=79001234567,74951234567  # legacy alias; лучше EXOLVE_AUTODIAL_NUMBERS
# Связующие DID только для скорозвона (принимают MakeCallback) — НЕ CLI обычных звонков:
# EXOLVE_AUTODIAL_NUMBERS=79390469156,79587793964
# Личные CLI менеджера (ротация исходящих):
# EXOLVE_CLI_NUMBERS=79587733452,79587702786
# Карусель: 1 SIP + N DID на менеджера → POST /telephony/exolve/admin/import
# Входящие Vox: номер + сценарий в manage.voximplant.com (не через EXOLVE_API_KEY)

# Автодозвон Недозвон 3 (Exolve MakeCallback): кандидат → параллельно softphone менеджеров
# EXOLVE_CALLBACK_RESOURCE_ID=   # ЛК Exolve → Callback → ID ресурса (или создастся через API)
# AUTODIAL_RETRY_MINUTES=30
# События Callback (push вместо только GetInfo-полла):
#   ЛК Exolve → приложение → Уведомления → URL для Callback / звонков:
#   https://<ваш-хост>/webhooks/exolve/callback/<CALL_WEBHOOK_SECRET>
#   Локально: cloudflared/ngrok на :8080. localhost Exolve не достучится.
# CALL_WEBHOOK_SECRET=  # тот же секрет, что для журнала звонков (/webhooks/telephony/...)
